# ui/Containerfile: vlix-ui, the Lab Index dashboard (prompt 03). The runtime
# holds only Nuxt's .output; the token directory is mounted read-only.
ARG NODE_IMAGE=docker.io/library/node:24-alpine

FROM ${NODE_IMAGE} AS build
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund --ignore-scripts
COPY . .
RUN npx nuxt prepare && npm run build

FROM ${NODE_IMAGE}
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000 \
    VLIX_CONTROLLER_URL=http://host.containers.internal:18801 \
    VLIX_TOKEN_FILE=/run/vlix/controller.token
WORKDIR /app
COPY --from=build --chown=root:root /src/.output ./.output
USER node
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:3000/healthz').then(r => process.exit(r.ok ? 0 : 1), () => process.exit(1))"
CMD ["node", ".output/server/index.mjs"]
